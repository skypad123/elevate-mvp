{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/types/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^build:types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "^build:types"]
    },
    "generate": { "cache": false },
    "migrate": { "cache": false },
    "seed": { "cache": false },
    "reset": { "cache": false }
  }
}
