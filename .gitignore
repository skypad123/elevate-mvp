# dependencies
node_modules/

# build output
dist/
coverage/
.turbo/
*.tsbuildinfo

# local data (uploads, certificates, pglite)
.data/

# env files (keep the example)
.env
.env.*
!.env.example

# Expo
.expo/
expo-env.d.ts
web-build/
apps/learner/ios
apps/learner/android
.metro-health-check*

# native signing
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.kotlin/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# certificate fallback fonts are provisioned per host, see apps/api/assets/fonts/fallback/README.md
apps/api/assets/fonts/fallback/*
!apps/api/assets/fonts/fallback/README.md

# Terraform (the provider lock file .terraform.lock.hcl is committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
