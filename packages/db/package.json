{
  "name": "@elevate/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./pglite": "./src/pglite.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file=../../.env --import tsx scripts/seed.ts",
    "reset": "node --env-file=../../.env --import tsx scripts/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@elevate/core": "*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@elevate/tsconfig": "*",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
