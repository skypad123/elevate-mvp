# Copy to terraform.tfvars (gitignored) and edit.
root_domain = "example.com"
github_repo = "skypad123/elevate-mvp"

# Flip each one to true after putting real keys in its SSM parameters (infra/README.md, step 4).
integrations = {
  resend = false
  stripe = false
  mux    = false
}

# seed_super_admin_email = "you@example.com"

# Switch to false once the browser console shows no CSP violations on the three sites.
csp_report_only = true

# course_previews = true  # false stops hover-preview clips being made and shown

# Staging is reachable only over Tailscale. Optional fallback addresses (IPv4, at most 4) that are
# let in as well, for when the connector is down.
# private_access_extra_cidrs = ["203.0.113.7/32"]

# GitHub's OIDC subject for this repo: sub_claim_prefix from
#   gh api repos/<owner>/<repo>/actions/oidc/customization/sub
github_oidc_subject_prefix = "repo:skypad123@27288135/elevate-mvp@1356076279"
