{
  "name": "elevate",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:types": "turbo run build:types",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:dupes": "node scripts/check-dupes.mjs",
    "db:generate": "npm -w @elevate/db run generate",
    "db:migrate": "npm -w @elevate/db run migrate",
    "db:seed": "npm -w @elevate/db run seed",
    "db:reset": "npm -w @elevate/db run reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "drizzle-orm": "1.0.0-rc.5",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "~19.3.0",
    "hono": "4.13.17",
    "zod": "4.6.7",
    "drizzle-orm": "1.0.0-rc.5",
    "typescript": "~6.0.3",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  }
}
