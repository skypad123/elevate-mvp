# Copy to .env at the repo root. The API loads it via `node --env-file`.
# Frontends read only EXPO_PUBLIC_* / VITE_* values (see the bottom section).

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://elevate:elevate@localhost:5432/elevate

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4400
API_URL=http://localhost:4400
LEARNER_URL=http://localhost:8081
TEACH_URL=http://localhost:5173
SUPPORT_URL=http://localhost:5174
# 32+ random bytes; used to sign local file URLs and hash tokens
SESSION_SECRET=change-me-to-a-long-random-string
# Enables /api/dev/* routes (local uploads, checkout sync without webhooks)
DEV_ENDPOINTS_ENABLED=true
# Seeded as super_admin so you can sign in to Elevate Support
SEED_SUPER_ADMIN_EMAIL=you@example.com

# ── Email: console | smtp | resend ──────────────────────────────────────────
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
MAIL_FROM="Elevate <hello@elevate.local>"

# ── Storage (audio, images, documents, certificates): local | s3 ────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Video: local | mux ──────────────────────────────────────────────────────
VIDEO_DRIVER=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Signing key id + base64-encoded private key (as downloaded from Mux)
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# ── Stripe (sandbox / test mode) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen` locally; two separate endpoint secrets in production
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Singapore domestic card pricing: 3.4% + S$0.50
STRIPE_FEE_BPS=340
STRIPE_FEE_FIXED_CENTS=50
PLATFORM_CURRENCY=sgd
# Default per-teacher commission (basis points); editable per teacher by a super admin
DEFAULT_COMMISSION_BPS=1500

# ── Frontends ───────────────────────────────────────────────────────────────
# Vite apps read ../../.env (envDir); Expo reads apps/learner/.env.
# In dev the learner app defaults to <metro host>:4400, so this is optional.
# VITE_API_URL=http://localhost:4400
# EXPO_PUBLIC_API_URL=http://localhost:4400
# Deployed builds bake these in at build time (the deploy workflow sets them per environment):
# VITE_LEARNER_URL=https://app.example.com      # Teach → "view course page" links
# EXPO_PUBLIC_WEB_URL=https://app.example.com   # native → web checkout hand-off

# Certificates: fonts tried when a learner/course name has glyphs Fraunces/Inter lack (Chinese,
# Tamil, …). Comma-separated absolute paths; files dropped in apps/api/assets/fonts/fallback/ are
# picked up automatically. Production: Noto Sans SC + Noto Sans Tamil (SIL OFL).
# CERTIFICATE_FALLBACK_FONTS=/System/Library/Fonts/Supplemental/Arial Unicode.ttf
