{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.elevatelearn.app",
        "EXPO_PUBLIC_WEB_URL": "https://staging.elevatelearn.app",
        "EXPO_PUBLIC_TEACH_URL": "https://teach.staging.elevatelearn.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.elevatelearn.app",
        "EXPO_PUBLIC_WEB_URL": "https://elevatelearn.app",
        "EXPO_PUBLIC_TEACH_URL": "https://teach.elevatelearn.app"
      }
    }
  },
  "submit": { "production": {} }
}
