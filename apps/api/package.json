{
  "name": "@elevate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/types/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "start:prod": "node dist/server.js",
    "migrate:prod": "node dist/migrate.js",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@elevate/core": "*",
    "@elevate/db": "*",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@mux/mux-node": "15.5.0",
    "@pdf-lib/fontkit": "1.1.1",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.17",
    "nodemailer": "10.4.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "regenerator-runtime": "^0.14.1",
    "resend": "6.37.0",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@elevate/tsconfig": "*",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsup": "^9.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
